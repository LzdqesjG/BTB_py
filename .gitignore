# venv
.venv/

# Py cache
__pycache__/

# Packages
Packages/

# Log files
*.log
logs/*
logs/

# Test files
tests/
_*.*

# Replay files
replays/*
replays/deleted/*
*.bpr

# backup files
*.bak

